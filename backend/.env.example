NODE_ENV=development
PORT=4000

# PostgreSQL connection string
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/mini_wallet?schema=public"

# Use a long random string, e.g. output of: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=1d

# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173

# Cookie settings. Use COOKIE_SAME_SITE=none and COOKIE_SECURE=true when the
# frontend and API are deployed on different domains without a proxy.
COOKIE_SAME_SITE=lax
COOKIE_SECURE=false

# Midtrans Snap (top up with real payment). Leave MIDTRANS_SERVER_KEY empty to disable it.
# Sandbox keys start with SB-Mid-server-. Never commit a real key.
MIDTRANS_SERVER_KEY=
MIDTRANS_IS_PRODUCTION=false
# Frontend URL Midtrans returns the user to. Defaults to the first CORS_ORIGINS entry.
# APP_URL=http://localhost:5173
# Instant top up without payment. Defaults to off in production once Midtrans is configured.
# ALLOW_DIRECT_TOPUP=true
